// nonprofit_blockchain/grant_tracking_contract.sol
// A simple Ethereum smart contract for grant disbursement and tracking

// SPDX-License-Identifier: MIT
pragma solidity ^0.8.0;

contract GrantTracker {
    address public admin;

    struct Grant {
        address recipient;
        uint256 amount;
        string purpose;
        bool disbursed;
    }

    Grant[] public grants;

    constructor() {
        admin = msg.sender;
    }

    function addGrant(address _recipient, uint256 _amount, string memory _purpose) public {
        require(msg.sender == admin, "Only admin can add grants");
        grants.push(Grant(_recipient, _amount, _purpose, false));
    }

    function disburseGrant(uint256 index) public {
        require(msg.sender == admin, "Only admin can disburse");
        Grant storage grant = grants[index];
        require(!grant.disbursed, "Already disbursed");
        grant.disbursed = true;
        payable(grant.recipient).transfer(grant.amount);
    }

    function getGrantsCount() public view returns (uint256) {
        return grants.length;
    }

    // Allow receiving ETH
    receive() external payable {}
}
```

